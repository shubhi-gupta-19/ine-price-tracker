{
  "name": "product-price-tracker-backend",
  "version": "1.0.0",
  "description": "Product Price Tracker backend using Express, Supabase and Playwright",
  "type": "module",
  "scripts": {
    "build": "npx playwright install chromium --with-deps",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
